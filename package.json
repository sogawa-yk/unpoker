{
  "name": "unpoker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p apps/server && tsc -p apps/web",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "npm run dev -w @unpoker/web",
    "build": "npm run build -w @unpoker/web && npm run build -w @unpoker/server",
    "start": "node apps/server/dist/index.js",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
